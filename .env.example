# ---- Discord ----------------------------------------------------------------
DISCORD_TOKEN=

# Optional: register slash commands in this one server (instant). Leave empty
# for global registration, which Discord can take up to an hour to show.
# Right click the server -> Copy ID with Developer Mode on.
DISCORD_GUILD_ID=

# Comma-separated. Case-insensitive, matched as whole words.
# Keep these specific: "mc" alone would fire on normal chat.
TRIGGER_KEYWORDS=start server,start mc

# Optional lockdown. Leave empty to allow everyone in the server.
# Channel/user/role IDs are snowflakes (right click -> Copy ID with dev mode on).
ALLOWED_CHANNEL_IDS=
ALLOWED_USER_IDS=
ALLOWED_ROLE_IDS=

# Seconds one user must wait between starts.
COOLDOWN_SECONDS=180

# How long /mcstatus may reuse a recent result before opening a browser again.
STATUS_CACHE_SECONDS=60

# ---- Aternos ----------------------------------------------------------------
# Preferred: run login.py and copy the printed cookie here.
ATERNOS_SESSION=
# Optional, from the same helper.
ATERNOS_SID=
# Optional: which server to open when the account has several.
ATERNOS_SERVER_ID=

# Or mount a full storage state (cookies + localStorage) created by login.py.
ATERNOS_STATE=state/aternos_state.json

# ---- Browser / run tuning ---------------------------------------------------
# true is fine on most hosts. Set false (uses Xvfb in the image) if Cloudflare
# keeps challenging headless Chromium.
HEADLESS=true

# Optional HTTP(S)/SOCKS proxy for the browser. A residential proxy is the
# reliable fix when the host's IP is blocked by Cloudflare.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Total time to wait for Online, including queue time.
START_TIMEOUT_SECONDS=2400
POLL_INTERVAL_SECONDS=7
TZ_NAME=Asia/Kolkata

LOG_LEVEL=INFO
